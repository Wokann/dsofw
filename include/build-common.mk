# Repository-local tools for assembly-only official firmware reconstruction.
# 官方固件从汇编源码重建；工具与只读 CRC32 记录均由 dsofw 自身提供。

ifeq ($(OS),Windows_NT)
TOOL_EXEEXT := .exe
else
TOOL_EXEEXT :=
endif

ARMIPS ?= $(TOOLS_ROOT)/armips/armips$(TOOL_EXEEXT)
DSFWTOOL ?= $(TOOLS_ROOT)/dsfwtool/dsfwtool$(TOOL_EXEEXT)
CRC_TOOL ?= $(TOOLS_ROOT)/crc/flashmecrc$(TOOL_EXEEXT)

# Normalize calibration/MAC bytes in memory for comparison. CRC32_END is the
# version-specific packed-component end, not the firmware capacity. Existing
# per-version .crc32 files are read-only references, never generated by make.
# 仅在内存中归一化校准/MAC 字节用于对比。CRC32_END 是各版本的组件流末端，
# 不是固件容量。各版本已有 .crc32 文件只读匹配，make 不生成或覆盖它们。
OFFICIAL_PRIVATE_FILL_START := 0x28
OFFICIAL_PRIVATE_FILL_END := 0x170

.PHONY: crc-tool
crc-tool:
	$(MAKE) -C "$(TOOLS_ROOT)/crc"
